NODE_ENV=production
PORT=3000
DB_PASSWORD=replace-with-staging-database-password
MYSQL_ROOT_PASSWORD=replace-with-staging-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CLIENT_URL=https://staging.your-domain.example
STAGING_URL=https://staging.your-domain.example
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
PUBLIC_AI_DAILY_LIMIT=5
PUBLIC_AI_MAX_OUTPUT_TOKENS=800
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=FahizHub <notifications@your-domain.example>
ADMIN_NOTIFICATION_EMAIL=fahizahmed18@gmail.com
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://api-staging.example.com/api/settings/google-calendar/callback
